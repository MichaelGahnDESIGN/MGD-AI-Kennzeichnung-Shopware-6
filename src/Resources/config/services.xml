<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!--
            Nur der Installer ist öffentlich, weil Shopware die Plugin-Hauptklasse
            selbst erzeugt und Lebenszyklusmethoden nicht per Konstruktorinjektion
            aufruft. Alle DAL-Abhängigkeiten bleiben explizit und nachvollziehbar.
        -->
        <service id="MGDAIImageLabels\Setup\CustomFieldSetInstaller" public="true">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field_set_relation.repository"/>
        </service>

        <!--
            Der öffentliche Datenerhalt-Dienst wird im aktiven Container genutzt.
            Der Plugin-Einstieg besitzt für Reinstallationen zusätzlich einen
            eng begrenzten Fallback aus denselben öffentlichen Core-Diensten.
        -->
        <service id="MGDAIImageLabels\Configuration\ConfigurationBackupStorage">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MGDAIImageLabels\Configuration\ConfigurationRetentionService" public="true">
            <argument type="service" id="MGDAIImageLabels\Configuration\ConfigurationBackupStorage"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <!-- GitHub-Prüfung ist standardmäßig aus und verändert keine Shopware-Datenbank.
             Die Vorbereitung validiert Release, Prüfsumme und ZIP, bevor Dateien gewechselt werden. -->
        <service id="MGDAIImageLabels\Update\ArchiveValidator"/>
        <service id="MGDAIImageLabels\Update\DownloadPolicy"/>
        <service id="MGDAIImageLabels\Update\GitHubClient">
            <argument type="service" id="MGDAIImageLabels\Update\DownloadPolicy"/>
        </service>
        <service id="MGDAIImageLabels\Update\AtomicInstaller">
            <argument type="service" id="MGDAIImageLabels\Update\ArchiveValidator"/>
        </service>
        <service id="MGDAIImageLabels\Update\GitHubReleaseUpdater">
            <argument type="service" id="MGDAIImageLabels\Update\GitHubClient"/>
            <argument type="service" id="MGDAIImageLabels\Update\AtomicInstaller"/>
            <argument type="service" id="Shopware\Core\Framework\Plugin\PluginService"/>
            <argument>%kernel.project_dir%</argument>
        </service>
        <service id="MGDAIImageLabels\Administration\Controller\UpdateController" public="true">
            <argument type="service" id="MGDAIImageLabels\Update\GitHubReleaseUpdater"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="MGDAIImageLabels\ScheduledTask\UpdateTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="MGDAIImageLabels\ScheduledTask\UpdateTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="MGDAIImageLabels\Update\GitHubReleaseUpdater"/>
            <tag name="messenger.message_handler" handles="MGDAIImageLabels\ScheduledTask\UpdateTask"/>
        </service>

        <!-- Kleine, explizit verdrahtete Dienste für das sichere Storefront-Viewmodell. -->
        <service id="MGDAIImageLabels\Media\MediaLabelMetadataNormalizer"/>
        <service id="MGDAIImageLabels\Configuration\DisplayConfigurationProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
        <service id="MGDAIImageLabels\Storefront\Label\LabelLanguageResolver"/>
        <service id="MGDAIImageLabels\Storefront\Label\LabelViewResolver">
            <argument type="service" id="MGDAIImageLabels\Media\MediaLabelMetadataNormalizer"/>
            <argument type="service" id="MGDAIImageLabels\Configuration\DisplayConfigurationProvider"/>
            <argument type="service" id="MGDAIImageLabels\Storefront\Label\LabelLanguageResolver"/>
        </service>
        <service id="MGDAIImageLabels\Storefront\Thumbnail\ThumbnailPresentationResolver"/>

        <!-- Resolver für das lokale, sicher konfigurierte CMS-Hintergrundmedium. -->
        <service id="MGDAIImageLabels\Cms\BackgroundImage\BackgroundImagePresentationNormalizer"/>
        <service id="MGDAIImageLabels\Cms\BackgroundImage\BackgroundImageCmsElementResolver">
            <argument type="service" id="MGDAIImageLabels\Cms\BackgroundImage\BackgroundImagePresentationNormalizer"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <!-- Idempotente, unverknüpfte CMS-Seitenerstellung über das öffentliche DAL. -->
        <service id="MGDAIImageLabels\Cms\Philosophy\PhilosophyPageCreator">
            <argument type="service" id="cms_page.repository"/>
        </service>
        <service id="MGDAIImageLabels\Cms\Philosophy\PhilosophyDefaultContent"/>
        <service id="MGDAIImageLabels\Administration\Controller\PreparePhilosophyPageController" public="true">
            <argument type="service" id="MGDAIImageLabels\Cms\Philosophy\PhilosophyPageCreator"/>
        </service>

        <!-- Das Tag ist in Shopware 6.6 und 6.7 der stabile Twig-Erweiterungsvertrag. -->
        <service id="MGDAIImageLabels\Storefront\Twig\LabelTwigExtension">
            <argument type="service" id="MGDAIImageLabels\Storefront\Label\LabelViewResolver"/>
            <argument type="service" id="Symfony\Component\HttpFoundation\RequestStack"/>
            <tag name="twig.extension"/>
        </service>
        <service id="MGDAIImageLabels\Storefront\Twig\ThumbnailPresentationTwigExtension">
            <argument type="service" id="MGDAIImageLabels\Storefront\Thumbnail\ThumbnailPresentationResolver"/>
            <tag name="twig.extension"/>
        </service>
        <service id="MGDAIImageLabels\Storefront\Twig\PhilosophyTwigExtension">
            <argument type="service" id="MGDAIImageLabels\Cms\Philosophy\PhilosophyDefaultContent"/>
            <tag name="twig.extension"/>
        </service>
    </services>
</container>
