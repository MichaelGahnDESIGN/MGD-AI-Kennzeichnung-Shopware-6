<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!--
            Nur der Installer ist öffentlich, weil Shopware die Plugin-Hauptklasse
            selbst erzeugt und Lebenszyklusmethoden nicht per Konstruktorinjektion
            aufruft. Alle DAL-Abhängigkeiten bleiben explizit und nachvollziehbar.
        -->
        <service id="MGDAIImageLabels\Setup\CustomFieldSetInstaller" public="true">
            <argument type="service" id="custom_field_set.repository"/>
            <argument type="service" id="custom_field_set_relation.repository"/>
        </service>
    </services>
</container>
