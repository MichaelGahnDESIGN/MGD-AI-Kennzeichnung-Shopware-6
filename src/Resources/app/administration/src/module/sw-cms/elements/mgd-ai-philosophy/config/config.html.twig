{% block sw_cms_element_config_mgd_ai_philosophy %}
<sw-cms-inherit-wrapper
    field="content"
    :element="element"
    :label="$tc('mgd-ai-image-labels.philosophy.contentLabel')"
>
    <template #default="{ isInherited }">
        <sw-text-editor
            :value="element.config.content.value"
            :disabled="isInherited"
            sanitize-input
            enable-transparent-background
            @update:value="onInput"
        />
    </template>
</sw-cms-inherit-wrapper>
{% endblock %}
