{#
 # Gekennzeichnetes CMS-Hintergrundbild ohne freie URL-, HTML- oder CSS-Werte.
 # Sämtliche Klassen werden serverseitig aus festen Positivlisten gewählt.
 #}
{% set presentation = element.data.presentation|default(null) %}
<div class="mgd-ai-background-image {{ presentation ? presentation.heightClass : 'mgd-ai-background-image--height-320' }} {{ presentation ? presentation.horizontalClass : 'mgd-ai-background-image--horizontal-center' }} {{ presentation ? presentation.verticalClass : 'mgd-ai-background-image--vertical-center' }} {{ presentation ? presentation.fallbackClass : 'mgd-ai-background-image--fallback-neutral-light' }}">
    {% if element.data.media and presentation %}
        {% set label = mgd_ai_image_label(element.data.media) %}
        {% if presentation.decorative is same as(true) %}
            {% set attributes = {
                'class': 'mgd-ai-background-image__media',
                'alt': '',
                'aria-hidden': 'true',
                'loading': 'lazy'
            } %}
        {% else %}
            {% set attributes = {
                'class': 'mgd-ai-background-image__media',
                'alt': presentation.altText,
                'loading': 'lazy'
            } %}
        {% endif %}

        {% sw_thumbnails 'mgd-ai-background-image-thumbnails' with {
            media: element.data.media,
            attributes: attributes,
            displayMode: 'cover',
            mgdAiLabel: label
        } %}
    {% endif %}

    <div class="mgd-ai-background-image__content">
        {% block element_mgd_ai_background_image_content %}{% endblock %}
    </div>
</div>
