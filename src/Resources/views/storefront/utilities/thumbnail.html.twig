{% sw_extends '@Storefront/storefront/utilities/thumbnail.html.twig' %}

{#
 # Shopwares vollständiges Eltern-Template bleibt die einzige Quelle für das
 # Bild und alle Attribute. Wir kapseln dessen fertige Ausgabe nur dann, wenn
 # das geprüfte Viewmodell tatsächlich sichtbar ist.
 #}
{% block thumbnail_utility -%}
    {%- set label = mgd_ai_image_label(media) -%}
    {%- set mediaClasses = (attributes.class|default(''))|split(' ') -%}
    {%- set isGalleryNavigationThumbnail = 'gallery-slider-thumbnails-image' in mediaClasses -%}
    {%- set thumbnailContent -%}{{ parent() }}{%- endset -%}

    {# Kleine Galerie-Navigationsbilder bleiben ohne sichtbares oder doppeltes Label. #}
    {%- if not label.visible or isGalleryNavigationThumbnail -%}
        {{- thumbnailContent -}}
    {%- else -%}
        {#
         # Der zentrale Thumbnail-Vertrag liefert responsive Blockbilder. Der
         # Aufrufer darf den Layoutmodus daher nicht durch freie Werte ersetzen.
         #}
        {%- sw_embed '@MGDAIImageLabels/storefront/component/mgd-ai-image-label/labeled-media.html.twig' with {
            label: label,
            intrinsicLayout: false,
            thumbnailContent: thumbnailContent
        } only -%}
            {%- block mediaContent -%}{{- thumbnailContent -}}{%- endblock -%}
        {%- end_sw_embed -%}
    {%- endif -%}
{%- endblock %}
