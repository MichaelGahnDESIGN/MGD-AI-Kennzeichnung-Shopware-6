parameters:
    # Level max ist strenger als der zugesagte Mindestwert 8 und schützt die
    # typisierten Grenzflächen des Plugins vor schleichenden Unklarheiten.
    level: max
    paths:
        - src
    tmpDir: .phpstan-cache
    excludePaths:
        analyse:
            - vendor/*
            - dist/*
            # erzeugter Plugin-Baukasten (bin/build-plugin-kit.php, nicht von Hand ändern)
            - src/Kit/*
