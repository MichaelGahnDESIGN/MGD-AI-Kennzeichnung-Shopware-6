# Isolierte Arbeitsbereiche von Codex und anderen Entwicklungswerkzeugen.
.worktrees/

# Lokal erzeugte Abhängigkeiten und Release-Artefakte.
/vendor/
/node_modules/
/dist/
/.phpunit.cache/
/.phpunit.result.cache
/.phpstan-cache/

# Playtests, Backups und Datenbankabzüge bleiben immer ausschließlich lokal.
/PLAYTEST/
/PlayTest/
/BACKUPS/
/Backups/
*.sql
*.sql.gz

# Umgebungsdateien können Zugangsdaten enthalten. Nur bewusst anonymisierte
# Beispieldateien dürfen versioniert werden.
.env*
!.env.example

# Betriebssystem- und Editorreste.
.DS_Store
